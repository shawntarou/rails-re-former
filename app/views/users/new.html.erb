<h1>New User Form</h1>

<%= render "errors", user: @user %>

<%= form_with model: @user do |user_form| %>
  <%= user_form.label :username, "Your Username:" %>
  <%= user_form.text_field :username , placeholder: "gamer123" %>

  <%= user_form.label :email, "Your Email:" %>
  <%= user_form.email_field :email, placeholder: "example@example.com" %>

  <%= user_form.label :password, "Your Password:" %>
  <%= user_form.password_field :password, value: @user&.password %>
  <br><br>
  <%= user_form.submit "Your Submit" %>
<% end %>

<% if false %> <!-- multiline comment, with ruby logic. yes. this is how you do it. -->
<form action="/users" method="post" accept-charset="UTF-8">

  <input
  type="hidden"
  name="authenticity_token"
  value="<%= form_authenticity_token %>"
  >

  <label for="username">Username:</label>
  <input type="text" id="username" name="user[username]" value="<%= @user&.username %>" autocomplete="off"><br><br>

  <label for="email">Email Address:</label>
  <input type="email" id="email" name="user[email]" value="<%= @user&.email %>" autocomplete="off"><br><br>


  <label for="password">Password:</label>
  <input type="password" id="password" name="user[password]" value="<%= @user&.password %>" autocomplete="off"><br><br>

  <input type="submit" value="Submit" name="commit">

</form>
<% end %>
